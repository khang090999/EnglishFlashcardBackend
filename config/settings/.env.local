app_debug=true

environment=local

django_secret_key=SECRET

frontend_url=

# Taken from compose.yaml
database_url=postgresql://english-flashcards-backend-user:manager@postgres:5432/english-flashcards-backend-dev

redis_url=redis://redis:6379/1

celery_task_always_eager=true

# Taken from compose.yaml
aws_s3_access_key_id=root
aws_s3_secret_access_key=rootroot
aws_s3_bucket_name=english-flashcards-backend-files
# Empty region works only if project use `s3-direct`
aws_s3_direct_region=us-west-1

sentry_dsn=

email_ui_url=http://mailpit:8025/
email_host=mailpit
email_host_user=
email_host_password=
email_host_port=1025
email_host_use_tls=
default_from_email=no-reply@english-flashcards-backend.com
